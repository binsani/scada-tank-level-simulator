APP_NAME="Tank Level SCADA Simulator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scada
DB_USERNAME=scada
DB_PASSWORD=scada

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_NAME="Tank Level SCADA Simulator"

# Public multi-visitor educational demo: isolate each anonymous visitor's simulation.
# With isolation enabled, do not run the shared `php artisan scada:tick` daemon.
# Simulation controls remain publicly accessible without login.
SCADA_VISITOR_ISOLATION_ENABLED=true
